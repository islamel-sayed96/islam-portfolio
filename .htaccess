# Hostinger's Git deployment clones this repo directly into public_html
# (no option to point the domain's document root at public/ instead), so
# this file routes every request into public/ and keeps everything else
# (app/, .env, vendor/, ...) unreachable directly from the browser.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ /public/$1 [L]
</IfModule>
